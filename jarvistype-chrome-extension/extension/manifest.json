{
  "manifest_version": 3,
  "name": "Windows Input Bridge",
  "version": "1.0",
  "key": "",
  "description": "System input relay service for Windows desktop integration",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardRead",
    "clipboardWrite",
    "nativeMessaging",
    "alarms",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/dashboard.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}